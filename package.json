{
  "name": "@aoc-enterprise/runtime",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "lint": "node scripts/check-node16-imports.mjs && node scripts/lint-architecture.mjs && node scripts/lint-public-surface.mjs",
    "test": "npm run build && node --test",
    "clean": "node scripts/clean.mjs",
    "validate:invalid-imports": "node scripts/assert-invalid-imports.mjs",
    "validate:publishability": "node scripts/validate-publishability.mjs",
    "check:protocol-consumption": "node scripts/check-protocol-consumption.mjs",
    "check:runtime-state": "node scripts/check-runtime-operational-state.mjs",
    "check:runtime-persistence": "node scripts/check-runtime-persistence.mjs",
    "check:runtime-federation": "npm run build --silent && node scripts/check-runtime-federation.mjs",
    "check:runtime-vault": "node scripts/check-runtime-vault-boundary.mjs",
    "check:aoc-boundaries": "node scripts/check-aoc-boundaries.mjs",
    "check:release-integrity": "node scripts/check-runtime-release-integrity.mjs",
    "validate:release": "npm run typecheck && npm run build && npm run lint && npm test && npm run check:protocol-consumption && npm run check:runtime-state && npm run check:runtime-persistence && npm run check:runtime-vault && npm run check:aoc-boundaries && npm run validate:publishability && npm run check:release-integrity"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./authorization": {
      "types": "./dist/src/runtime/authorization/index.d.ts",
      "default": "./dist/src/runtime/authorization/index.js"
    },
    "./audit": {
      "types": "./dist/src/runtime/audit/index.d.ts",
      "default": "./dist/src/runtime/audit/index.js"
    },
    "./crypto": {
      "types": "./dist/src/runtime/crypto/index.d.ts",
      "default": "./dist/src/runtime/crypto/index.js"
    },
    "./adapters": {
      "types": "./dist/src/runtime/adapters/index.d.ts",
      "default": "./dist/src/runtime/adapters/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    },
    "./runtime-host": {
      "types": "./dist/src/runtime/index.d.ts",
      "default": "./dist/src/runtime/index.js"
    }
  },
  "peerDependencies": {
    "@aoc/protocol": ">=0.1.0",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@aoc-enterprise/pmfreak-agent-passport-foundation": "*",
    "@aoc/protocol": "file:../Architects_of_Change_Protocol/packages/protocol",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
