# ============================================================
# AOC Agent Passport Web — Environment Variables
# Copy to .env.local and fill in your values.
# ============================================================

# ---- Database ----
# Path to the SQLite database file (relative to project root).
# Defaults to .data/agent-passport.sqlite if not set.
# Use :memory: in tests for isolation.
AGENT_PASSPORT_DB_PATH=.data/agent-passport.sqlite

# ---- Passport Issuer (HMAC-SHA256) ----
# Required in production (NODE_ENV=production).
# In development a safe fallback is used automatically.
PASSPORT_ISSUER_ID=your-issuer-id
PASSPORT_ISSUER_NAME=Your Governance Authority
PASSPORT_ISSUER_KEY_ID=hmac-key-2024-01
# High-entropy secret — min 32 chars — NEVER commit real value
PASSPORT_SIGNING_SECRET=replace-with-secure-random-secret-min-32-chars

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_AGENT_PASSPORT_SINGLE=price_...
STRIPE_PRICE_GOVERNED_AGENT=price_...
STRIPE_PRICE_ORG_AGENT_REGISTRY=price_...

# ---- App URLs ----
NEXT_PUBLIC_AGENT_PASSPORT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Dev signing (legacy — prefer PASSPORT_SIGNING_SECRET) ----
# AOC_DEV_SIGNING_SECRET=aoc-dev-signing-secret-not-for-production

# ---- Registry admin session (DB-backed sessions used by default) ----
# Optional: set a signing secret if adding signed-cookie session support.
# In production, fail if required by your session implementation.
# AOC_REGISTRY_ADMIN_SESSION_SECRET=replace-with-strong-random-secret

# ---- Buyer account sessions (DB-backed opaque sessions — no signing secret required) ----
# Sessions are stored in buyer_account_sessions table.
# Cookie: aoc_buyer_account_session (HttpOnly, SameSite=Lax, Secure in production).
# No secret key required since tokens are random + hashed in DB.
# AOC_BUYER_ACCOUNT_SESSION_SECRET is NOT required for current implementation.

# ---- Stripe Billing Portal ----
# Required for the Customer Portal ("Manage Billing") feature.
# Configure your portal at https://dashboard.stripe.com/test/settings/billing/portal
# before enabling. If not set, the portal endpoint returns a 503.
# STRIPE_BILLING_PORTAL_RETURN_URL is the URL Stripe redirects to after the portal.
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/account/dashboard
