{
  "compilerOptions": {
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": false,
    "outDir": "dist-test",
    "rootDir": "."
  },
  "include": ["src/lib/**/*.ts", "__tests__/**/*.ts"]
}
