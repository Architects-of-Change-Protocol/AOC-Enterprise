{
  "name": "@aoc-enterprise/agent-governance",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./passport": {
      "types": "./dist/passport/passport-contracts.d.ts",
      "default": "./dist/passport/passport-contracts.js"
    },
    "./crypto": {
      "types": "./dist/crypto/canonical-json.d.ts",
      "default": "./dist/crypto/canonical-json.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/__tests__/**/*.test.js'"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aoc-enterprise/identity": "file:../identity"
  }
}
